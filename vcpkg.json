{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "emap",
    "version": "3.2.1",
    "dependencies": [
        "cryptopp",
        "fast-cpp-csv-parser",
        "doctest",
        "eigen3",
        "tiff",
        "date",
        "libxlsxwriter",
        "bfgroup-lyra",
        "fmt",
        "gsl",
        {
            "name": "proj",
            "default-features": false,
            "features": ["embed-data"]
        },
        {
            "name": "gdal",
            "default-features": false,
            "features": ["expat", "sqlite3", "geos"]
        },
        "indicators",
        "spdlog",
        "tbb",
        "tomlplusplus",
        "type-safe",
        "vc"
    ],
    "vcpkg-configuration": {
        "default-registry": {
            "kind": "git",
            "baseline": "66c0373dc7fca549e5803087b9487edfe3aca0a1",
            "repository": "https://github.com/microsoft/vcpkg"
        },
        "overlay-ports": ["./deps/infra/vcpkg_overlay/ports"],
        "overlay-triplets": ["./deps/infra/vcpkg_overlay/triplets"]
    }
}
